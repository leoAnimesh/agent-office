{
  "name": "agent-office",
  "version": "0.1.0",
  "description": "A pixel-art office where a boss Claude Code agent hires and delegates to a team of specialist agents.",
  "main": "./out/main/index.js",
  "author": "leoAnimesh <mondalarup808@gmail.com>",
  "license": "MIT",
  "repository": "github:leoAnimesh/agent-office",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "pack": "npm run build && electron-builder --dir --publish never",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cross-spawn": "^7.0.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  },
  "homepage": "https://github.com/leoAnimesh/agent-office"
}
